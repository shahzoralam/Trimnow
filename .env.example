# TrimNow Supabase environment variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local — it contains secrets.

# Public Supabase project URL
VITE_SUPABASE_URL=https://glkltxnqwkgmeycmpfot.supabase.co

# Supabase publishable (anon) key — safe to expose in frontend
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server-side only (DO NOT prefix with VITE_ — never exposed to browser)
SUPABASE_URL=https://glkltxnqwkgmeycmpfot.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here